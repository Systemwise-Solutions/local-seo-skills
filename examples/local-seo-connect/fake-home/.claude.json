{
  "numStartups": 12,
  "mcpServers": {
    "dfs-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "dataforseo-mcp-server"
      ],
      "env": {
        "DATAFORSEO_USERNAME": "FAKE-not-a-real-login",
        "DATAFORSEO_PASSWORD": "FAKE-not-a-real-password"
      }
    },
    "searchops": {
      "type": "http",
      "url": "https://searchops.co/api/mcp",
      "headers": {
        "Authorization": "Bearer lp_live_FAKE_not_a_real_key"
      }
    }
  },
  "projects": {
    "C:/Users/example/old-website-project": {
      "mcpServers": {
        "gsc": {
          "type": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "search-console-mcp"
          ],
          "env": {
            "GOOGLE_APPLICATION_CREDENTIALS": "C:/Users/example/FAKE-creds.json"
          }
        }
      }
    }
  }
}